<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS'te çalıştırma (sitenin altında "Convert to Application" ile, ör. /bilye-ligi)

  Gerekenler:
  - ASP.NET Core Module V2 (ASP.NET Core Hosting Bundle ile gelir). IIS Yöneticisi > sunucu > Modules
    listesinde "AspNetCoreModuleV2" görünmeli.
  - Node.js C:\nodejs\node.exe (farklı yerdeyse aşağıdaki processPath'i değiştirin).
  - Uygulama klasöründe node_modules klasörü (npm ci ile kurulur ya da hazır kopyalanır).
    Not: XML açıklamalarında iki tire yan yana yazılamaz, bu yüzden komut burada tam yazılmadı.
  - Uygulama havuzu: .NET CLR sürümü "Yönetilen kod yok", Boşta kalma zaman aşımı 0 önerilir
    (havuz kapanınca açık odalar silinir).
  - İsteğe bağlı: IIS "WebSocket Protocol" özelliği. Yoksa oyun HTTP uzun sorgulamayla çalışır.

  IIS, uygulama ilk istek geldiğinde node'u başlatır, portu ASPNETCORE_PORT ile, uygulama adresini
  (/bilye-ligi) ASPNETCORE_APPL_PATH ile verir; server/index.js ikisini de okur.
  Sorun olursa stdoutLogEnabled="true" yapın; kayıtlar logs\ klasörüne yazılır
  (uygulama havuzu kimliğinin bu klasöre yazma izni olmalı).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="C:\nodejs\node.exe"
                arguments=".\server\index.js"
                hostingModel="OutOfProcess"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\node"
                startupTimeLimit="60"
                requestTimeout="00:02:00">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </aspNetCore>
    <!-- Üst sitenin URL Rewrite kuralları (ör. "bulunamayanı ana uygulamaya gönder") alt uygulamaya
         miras kalır ve oyunun bağlantı adreslerini başka uygulama havuzuna yönlendirip 403.18 verdirir.
         Burada temizlenir. Sunucuda URL Rewrite modülü kurulu değilse bu rewrite bloğunu silin
         (yoksa IIS 500.19 verir). -->
    <rewrite>
      <rules>
        <clear />
      </rules>
    </rewrite>
    <!-- Üst sitenin özel hata sayfaları node'un yanıtlarını değiştirmesin -->
    <httpErrors existingResponse="PassThrough" />
    <!-- node_modules, server, testler ve data (lig tablosu) zaten node tarafından servis edilmez; IIS de doğrudan vermesin -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="server" />
          <add segment="tests" />
          <add segment=".git" />
          <add segment="data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
